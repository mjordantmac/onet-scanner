{
  "name": "jev-scanner",
  "version": "1.0.0",
  "private": true,
  "description": "Scores every O*NET task for how well TypeSafe's Jev model can do it, then ranks the best as business ideas.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest:onet": "node src/ingest-onet.js",
    "ingest:bls": "node src/ingest-bls.js",
    "ingest": "node src/ingest-onet.js && node src/ingest-bls.js",
    "pilot": "node src/jev-score.js --pilot",
    "score:all": "node src/jev-score.js --all",
    "rank": "node src/rank.js"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.3"
  }
}
